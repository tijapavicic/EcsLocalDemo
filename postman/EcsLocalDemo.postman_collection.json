              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/files/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "files", "upload"]
        },
        "description": "❌ ERROR CASE: Empty Bearer token.\n\nExpected: 400 Bad Request\nError: \"Bearer token is empty\"\n\nFix: Provide valid Base64 token after 'Bearer '"
      }
    },
    {
      "name": "❌ Error: Wrong Authorization Prefix",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic {{user1_token}}",
            "type": "text",
            "description": "Uses 'Basic' instead of 'Bearer'"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/files/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "files", "upload"]
        },
        "description": "❌ ERROR CASE: Using 'Basic' instead of 'Bearer' prefix.\n\nExpected: 400 Bad Request\nError: \"Authorization header must start with 'Bearer '\"\n\nFix: Use 'Bearer ' prefix before token"
      }
    },
    {
      "name": "❌ Error: Empty File Upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Don't select a file, or select an empty file"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/files/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "files", "upload"]
        },
        "description": "❌ ERROR CASE: Empty file upload.\n\nExpected: 400 Bad Request\nError: \"file is empty\"\n\nFix: Select a file with content"
      }
    },
    {
      "name": "📋 Generate Bearer Token (Base64 Encoder Guide)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://www.base64encode.org/",
          "protocol": "https",
          "host": ["www", "base64encode", "org"]
        },
        "description": "Guide: How to create custom Bearer tokens.\n\n1. Go to https://www.base64encode.org/\n2. Enter: userId:email (e.g., john:john@example.com)\n3. Copy the Base64 output\n4. In Postman, create new header: Authorization: Bearer <output>\n\nOr use command line:\n```bash\necho -n \"john:john@example.com\" | base64\n# Output: am9objpqb2huQGV4YW1wbGUuY29t\n# Usage: Authorization: Bearer am9objpqb2huQGV4YW1wbGUuY29t\n```\n\nPre-configured tokens in Variables:\n- user1_token = user123:user@example.com\n- user2_token = json:test@example.com\n- user3_token = developer:dev@example.com"
      }
    }
  ]
}

